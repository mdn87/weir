{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lugos.local/weir/web-request.schema.json",
  "title": "WebRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "run_id", "mode", "data_class", "auth_context", "evidence_required", "side_effects_allowed"],
  "properties": {
    "contract_version": {"const": "0.1"},
    "request_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "intent": {"type": "string"},
    "mode": {"enum": ["discover", "search", "read", "observe", "interact", "commit"]},
    "url": {"type": ["string", "null"], "format": "uri"},
    "query": {"type": ["string", "null"]},
    "source": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "constraints": {"type": "object", "default": {}},
    "data_class": {"enum": ["public", "personal", "bwa_internal", "restricted"]},
    "auth_context": {"type": "string"},
    "profile_id": {"type": ["string", "null"]},
    "allowed_domains": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 253,
        "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?))*$"
      },
      "uniqueItems": true
    },
    "preferred_engine": {"type": ["string", "null"]},
    "maximum_depth": {"type": "integer", "minimum": 0, "default": 0},
    "evidence_required": {"type": "boolean"},
    "side_effects_allowed": {"type": "boolean"},
    "capture_policy": {"enum": ["metadata", "content", "full_evidence"], "default": "content"}
  },
  "allOf": [
    {
      "anyOf": [
        {"required": ["url"], "properties": {"url": {"type": "string", "format": "uri"}}},
        {"required": ["query"], "properties": {"query": {"type": "string", "minLength": 1}}}
      ]
    },
    {
      "if": {"required": ["mode"], "properties": {"mode": {"enum": ["discover", "search", "read", "observe"]}}},
      "then": {"properties": {"side_effects_allowed": {"const": false}}}
    },
    {
      "if": {"required": ["mode"], "properties": {"mode": {"const": "search"}}},
      "then": {
        "required": ["query", "source"],
        "properties": {
          "query": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {"required": ["auth_context"], "properties": {"auth_context": {"const": "none"}}},
      "then": {"properties": {"profile_id": {"type": "null"}}}
    }
  ]
}
