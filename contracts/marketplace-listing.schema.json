{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lugos.local/weir/marketplace-listing.schema.json",
  "title": "MarketplaceListing",
  "description": "Normalized marketplace listing carried inside a WebCapture content listing array. Unknown fields are explicitly 'unknown', never guessed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "source_item_id", "canonical_url", "title", "price", "shipping", "condition", "observed_at", "content_hash", "enrichment"],
  "properties": {
    "source": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "source_item_id": {"type": "string", "minLength": 1},
    "canonical_url": {"type": "string", "format": "uri"},
    "title": {"type": "string"},
    "price": {
      "oneOf": [
        {"const": "unknown"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "currency"],
          "properties": {
            "amount": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
            "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
          }
        }
      ]
    },
    "shipping": {
      "oneOf": [
        {"const": "unknown"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "currency"],
          "properties": {
            "amount": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
            "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
          }
        }
      ]
    },
    "condition": {
      "oneOf": [
        {"const": "unknown"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["raw"],
          "properties": {
            "raw": {"type": "string"},
            "condition_id": {"type": ["string", "null"]}
          }
        }
      ]
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "enrichment": {"enum": ["none", "page", "rendered"]},
    "raw": {"description": "Immutable source payload for this listing as returned by the provider API."}
  }
}
