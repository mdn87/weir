{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lugos.local/weir/action-proposal.schema.json",
  "title": "ActionProposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "action_id", "request_id", "owner_run_id",
    "work_context_hash", "correlation_id", "assignment_id", "session_id",
    "session_revision", "session_epoch", "observation_id", "observation_hash",
    "action_type", "semantic_locator", "resolved_target", "parameters",
    "parameter_data_class", "risk",
    "requires_approval", "preconditions", "expected_postconditions", "evidence_refs",
    "created_at", "expires_at", "proposal_hash"
  ],
  "properties": {
    "contract_version": {"const": "0.3"},
    "action_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "owner_run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "work_context_hash": {"$ref": "#/$defs/digest"},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "assignment_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "session_revision": {"type": "integer", "minimum": 0},
    "session_epoch": {"type": "integer", "minimum": 1},
    "observation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "observation_hash": {"$ref": "#/$defs/digest"},
    "action_type": {"enum": ["click", "fill", "select", "check", "uncheck", "upload", "submit"]},
    "semantic_locator": {"$ref": "#/$defs/semanticLocator"},
    "resolved_target": {"$ref": "#/$defs/resolvedTarget"},
    "parameters": {"$ref": "#/$defs/portableObject"},
    "parameter_data_class": {"enum": ["public", "personal", "bwa_internal", "restricted"]},
    "risk": {"$ref": "#/$defs/risk"},
    "requires_approval": {"const": true},
    "preconditions": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/condition"}},
    "expected_postconditions": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/condition"}},
    "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 512}, "uniqueItems": true},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "proposal_hash": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"action_type": {"enum": ["click", "fill", "select", "check", "uncheck"]}}, "required": ["action_type"]},
      "then": {"properties": {"risk": {"const": "unknown"}}}
    },
    {
      "if": {"properties": {"action_type": {"const": "upload"}}, "required": ["action_type"]},
      "then": {"properties": {"risk": {"enum": ["external_upload", "external_submit", "message_send", "purchase", "account_change", "credential_change", "destructive", "unknown"]}}}
    },
    {
      "if": {"properties": {"action_type": {"const": "submit"}}, "required": ["action_type"]},
      "then": {"properties": {"risk": {"enum": ["external_submit", "message_send", "purchase", "account_change", "credential_change", "destructive", "unknown"]}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "portableKey": {
      "allOf": [
        {"pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
        {"not": {"enum": ["api_key", "authorization", "bearer_token", "cookie", "password", "refresh_token", "secret", "secret_values", "token"]}}
      ]
    },
    "portableObject": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {"$ref": "#/$defs/portableKey"},
      "additionalProperties": {"$ref": "#/$defs/portableValue"}
    },
    "portableValue": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
        {"type": "string", "maxLength": 16384},
        {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/portableValue"}},
        {"$ref": "#/$defs/portableObject"}
      ]
    },
    "risk": {
      "enum": ["read_only", "reversible", "local_mutation", "external_upload", "external_submit", "message_send", "purchase", "account_change", "credential_change", "destructive", "unknown"]
    },
    "semanticLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "role", "name", "name_match", "test_id", "required_state", "ordinal"],
      "properties": {
        "contract_version": {"const": "0.2"},
        "role": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}
          ]
        },
        "name": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
          ]
        },
        "name_match": {"enum": ["exact", "casefold"]},
        "test_id": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
          ]
        },
        "required_state": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}
          ]
        },
        "ordinal": {"type": ["integer", "null"], "minimum": 0}
      },
      "anyOf": [
        {"properties": {"role": {"type": "string"}}},
        {"properties": {"name": {"type": "string"}}},
        {"properties": {"test_id": {"type": "string"}}}
      ],
      "allOf": [
        {
          "if": {"properties": {"name": {"type": "null"}}, "required": ["name"]},
          "then": {"properties": {"name_match": {"const": "exact"}}}
        }
      ]
    },
    "resolvedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "observation_id", "session_id", "session_revision", "session_epoch", "element_ref", "role", "name", "test_id", "state", "locator_hash"],
      "properties": {
        "contract_version": {"const": "0.2"},
        "observation_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "session_revision": {"type": "integer", "minimum": 0},
        "session_epoch": {"type": "integer", "minimum": 1},
        "element_ref": {"type": "string", "minLength": 1},
        "role": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "name": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
          ]
        },
        "test_id": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
          ]
        },
        "state": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}
          ]
        },
        "locator_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "expected", "locator", "target"],
      "properties": {
        "kind": {"enum": ["url_equals", "element_present", "element_state_equals", "observation_hash_equals"]},
        "expected": {},
        "locator": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/semanticLocator"}]},
        "target": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/resolvedTarget"}]}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {"enum": ["element_present", "element_state_equals"]}
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "locator": {"$ref": "#/$defs/semanticLocator"},
              "target": {"$ref": "#/$defs/resolvedTarget"}
            }
          },
          "else": {
            "properties": {
              "locator": {"type": "null"},
              "target": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "element_present"}}, "required": ["kind"]},
          "then": {"properties": {"expected": {"type": "boolean"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "element_state_equals"}}, "required": ["kind"]},
          "then": {"properties": {"expected": {"type": ["string", "null"]}}}
        },
        {
          "if": {"properties": {"kind": {"const": "url_equals"}}, "required": ["kind"]},
          "then": {"properties": {"expected": {"type": "string", "minLength": 1}}}
        },
        {
          "if": {"properties": {"kind": {"const": "observation_hash_equals"}}, "required": ["kind"]},
          "then": {"properties": {"expected": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}
        }
      ]
    }
  }
}
