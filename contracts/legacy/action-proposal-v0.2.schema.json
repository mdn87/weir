{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lugos.local/weir/legacy/action-proposal-v0.2.schema.json",
  "title": "LegacyActionProposalV0_2",
  "description": "Read-only compatibility schema retained through the Batch 0 published retention window. New producers emit ActionProposal v0.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "action_id", "request_id", "owner_run_id", "session_id",
    "session_revision", "session_epoch", "observation_id", "observation_hash",
    "action_type", "semantic_locator", "resolved_target", "parameters", "risk",
    "requires_approval", "preconditions", "expected_postconditions", "evidence_refs",
    "created_at", "expires_at", "proposal_hash"
  ],
  "properties": {
    "contract_version": {"const": "0.2"},
    "action_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "owner_run_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "session_revision": {"type": "integer", "minimum": 0},
    "session_epoch": {"type": "integer", "minimum": 1},
    "observation_id": {"type": "string", "minLength": 1},
    "observation_hash": {"$ref": "#/$defs/digest"},
    "action_type": {"enum": ["click", "fill", "select", "check", "uncheck", "upload", "submit"]},
    "semantic_locator": {"$ref": "../action-proposal.schema.json#/$defs/semanticLocator"},
    "resolved_target": {"$ref": "../action-proposal.schema.json#/$defs/resolvedTarget"},
    "parameters": {"type": "object"},
    "risk": {"$ref": "../action-proposal.schema.json#/$defs/risk"},
    "requires_approval": {"const": true},
    "preconditions": {"type": "array", "items": {"$ref": "../action-proposal.schema.json#/$defs/condition"}},
    "expected_postconditions": {"type": "array", "items": {"$ref": "../action-proposal.schema.json#/$defs/condition"}},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "proposal_hash": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"action_type": {"enum": ["click", "fill", "select", "check", "uncheck"]}}, "required": ["action_type"]},
      "then": {"properties": {"risk": {"const": "unknown"}}}
    },
    {
      "if": {"properties": {"action_type": {"const": "upload"}}, "required": ["action_type"]},
      "then": {"properties": {"risk": {"enum": ["external_upload", "external_submit", "message_send", "purchase", "account_change", "credential_change", "destructive", "unknown"]}}}
    },
    {
      "if": {"properties": {"action_type": {"const": "submit"}}, "required": ["action_type"]},
      "then": {"properties": {"risk": {"enum": ["external_submit", "message_send", "purchase", "account_change", "credential_change", "destructive", "unknown"]}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
